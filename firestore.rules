rules_version = '2';

// Regras do Firestore para o portfólio.
// Substitua ADMIN_EMAIL pelo MESMO valor de NEXT_PUBLIC_ADMIN_EMAIL no .env.local.
// Aplicar em: Firebase Console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Projetos: leitura pública (galeria); escrita apenas do admin.
    match /projetos/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }

    // Mensagens de contato: qualquer visitante cria; só o admin lê/edita/apaga.
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }
  }
}
