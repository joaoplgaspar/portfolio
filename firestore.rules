rules_version = '2';

// Regras do Firestore para o portfólio.
// Troque ADMIN_EMAIL pelo MESMO valor de NEXT_PUBLIC_ADMIN_EMAIL no .env.local.
// Aplicar em: Firebase Console → Firestore Database → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Projetos: leitura pública apenas dos publicados; escrita só do admin.
    match /projects/{id} {
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.token.email == "ADMIN_EMAIL");
      allow write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }
  }
}
