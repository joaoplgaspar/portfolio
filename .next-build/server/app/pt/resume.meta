{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/resume/layout,_N_T_/[locale]/resume/page,_N_T_/pt/resume"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/resume/__PAGE__",
    "/$d$locale/resume",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}