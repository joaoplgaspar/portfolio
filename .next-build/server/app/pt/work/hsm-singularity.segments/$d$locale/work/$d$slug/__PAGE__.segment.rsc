f:["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","p","0",{"children":[["$","$1","0",{"children":["Quando uma empresa compra no Brasil, parte dos tributos federais é retida na fonte: ela paga o pedido menos a retenção e recolhe o resto direto com a Receita. O Shopify não tem esse conceito. As configurações de imposto dele só somam imposto, não subtraem, e não mudam conforme quem está comprando. E o valor que o checkout mostra precisa bater com a nota no centavo."]}]]}]]}]
10:["$","section","2",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"O que eu construí"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Retenção como desconto, numa Shopify Function"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A regra roda numa Function de desconto e devolve um valor fixo no pedido, com o nome “Retenção na fonte”. Ela considera faixas de valor, a isenção parcial de quem é optante do Simples Nacional e três formas de reconhecer uma compra de empresa: o CNPJ, uma tag de cliente ou uma empresa B2B."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"CNPJ validado no campo nativo"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Uma Function de validação confere os dígitos verificadores e trava o checkout antes do pagamento quando o número está malformado."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Uma extensão de checkout que mantém a Function em dia"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A Function não enxerga o campo nativo de documento ao vivo. A extensão copia o CNPJ para um metafield do carrinho, cada escrita roda a regra de novo, e a própria extensão mostra o detalhamento por tributo."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Alíquotas como dado"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Faixas e alíquotas ficam num JSON em metafield que a Function, a extensão e um formulário no admin leem. Mudar uma alíquota é editar o admin, sem deploy."]}]]}]]}],["$","li","4",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Formulários feitos de metaobjects, entregues no Salesforce"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Campos e etapas são metaobjects, e cada produto escolhe o seu formulário. O servidor refaz a validação a partir da definição do admin e cria o lead no Salesforce por OAuth. Se o CRM recusa um valor, ele vai para a descrição e o envio é repetido, então um erro de digitação no admin não perde lead."]}]]}]]}],["$","li","5",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Duas marcas, um build"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A marca é resolvida em tempo de execução pelo ambiente, o tema é isolado por atributo no HTML, e os e-mails transacionais das duas marcas saem do mesmo conjunto de templates."]}]]}]]}]]}]]}]]}]
11:["$","section","3",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"Por que foi feito assim"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Desconto, porque imposto no Shopify só sobe"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Modelar a retenção como desconto de pedido com valor fixo é o jeito de o total do checkout mostrar o que a empresa realmente paga."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Centavos inteiros nas duas pontas"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A Function e a extensão calculam separadas. Com ponto flutuante, em alguns totais elas discordariam em um centavo na frente do cliente. As duas usam a mesma conta em inteiros, com arredondamento half-up."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"A definição do formulário vale no servidor"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A validação é refeita a partir do admin, então o cliente não pula campo obrigatório, e quem edita o formulário não depende de deploy."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Falhar com calma no CRM"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["CRM recusa valor de lista o tempo todo. Um lead perdido custa mais que uma descrição bagunçada."]}]]}]]}]]}]]}]]}]
