33:["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"The “never cache an empty list” rule"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A failing source returning "]}],["$","code","1",{"className":"case-code","children":"[]"}],["$","$1","2",{"children":[" would poison the cache for its entire TTL, making books invisible. Every cache layer validates before persisting."]}]]}]]}]
34:["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Cost as a requirement"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["~40 reads per search were replaced by layered caches, each with its own TTL (5 min ISBN, 24 h text, 7 days CBL). The Google Books quota became an observable metric: a production 503 taught me the difference between a daily quota and a soft rate limit, and the fix was staggered requests plus a circuit breaker, not “retry harder.”"]}]]}]]}]
35:["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Defense in depth as a pattern"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Every bug is fixed at the source (the server), backed by a client-side defense (self-healing) and a cleanup script for data already written. That lets a live catalog evolve without painful migrations."]}]]}]]}]
