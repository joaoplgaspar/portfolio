2e:["$","p","1",{"children":[["$","$1","0",{"children":["It was the first shared cart the agency had ever delivered. There was no internal reference, no “we did it this way last time” — the architecture had to be researched and argued for before it became code."]}]]}]
2f:["$","section","2",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"What the squad built"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Shared cart with a single checkout"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Instead of two carts trying to stay in sync, both storefronts talk to a shared connection point that builds and owns a single cart. Adding an item from either brand feeds the same checkout."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Cross-brand search with canonical PDPs"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Searching on Roland returns the full catalog from both brands. Clicking a Boss result lands straight on the PDP on the Boss domain, and vice versa. One catalog, but each product still lives on its own brand's site."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Configurable campaign scheduling"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Banners and sections with start and end windows, built by us and exposed as configuration inside Weaverse. The client's team decides when Black Friday goes up and when it comes down, with no deploy from us."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"The ongoing work"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A header rebuild, improvements to the banner system and continuous performance work, always on a store that can't go offline."]}]]}]]}]]}]]}]]}]
30:["$","section","3",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"Why it's built this way"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"One cart, not two in sync"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["The tempting path was to mirror state across both storefronts. Syncing replicas is where race conditions live: items vanish, quantities drift, and the bug only shows up in production, on two devices. Building the cart in one shared place trades a distributed problem for an integration problem, which is far easier to test and explain."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"One catalog, brand-aware navigation"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Duplicating products per brand would have solved search in five minutes and created duplicate content, cannibalized SEO and two places to update a price. Each product has one owner: search crosses the boundary, and the PDP is canonical on the right domain."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Campaign dates are config, not deploys"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Campaign dates always change at the last minute. Every seasonal feature shipped with a window the client edits in Weaverse. That takes the agency off the critical path of running the store and removes a whole class of night-before-the-holiday emergencies."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Leading was worth more than coding"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Since this was the agency's first project of its kind, my most valuable work was researching the options, validating the architecture and guiding the team to it, not writing the code. I spent more time unblocking decisions than typing, and the delivery was better for it."]}]]}]]}]]}]]}]]}]
