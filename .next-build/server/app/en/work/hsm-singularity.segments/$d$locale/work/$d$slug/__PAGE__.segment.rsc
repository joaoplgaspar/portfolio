e:["$","p","0",{"children":[["$","$1","0",{"children":["When a company buys in Brazil, part of the federal taxes is withheld at source: the company pays the order minus the withholding and settles the rest with the tax authority. Shopify has no such concept. Its tax settings add tax; they can't subtract it, and they don't change based on who is buying. And the number on the checkout has to match the invoice to the cent."]}]]}]
f:["$","section","2",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"What I built"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Withholding as a discount, in a Shopify Function"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["The rule runs in a discount Function and returns a fixed order-level amount labeled “Withholding at source.” It handles value tiers, the partial exemption for companies under Simples Nacional, and three ways to recognize a company purchase: the CNPJ, a customer tag or a B2B company."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"CNPJ validated in the native field"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["A validation Function checks the CNPJ check digits and blocks the checkout before payment when the number is malformed."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"A checkout extension that keeps the Function in sync"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["The Function can't read the native tax ID field live. The extension copies the CNPJ into a cart metafield, every write re-runs the rule, and the extension itself shows the per-tax breakdown."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Rates as data"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Tiers and rates live in a JSON metafield read by the Function, the extension and a settings form in the admin. Changing a rate is an admin edit, with no deploy."]}]]}]]}],["$","li","4",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Forms built from metaobjects, delivered to Salesforce"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Fields and steps are metaobjects, and each product picks its form. The server rebuilds validation from the admin definition and creates the lead in Salesforce over OAuth. When the CRM rejects a value, it moves into the description and the request is retried, so a typo in the admin never loses a lead."]}]]}]]}],["$","li","5",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Two brands, one build"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["The brand is resolved at runtime from the environment, the theme is scoped by an attribute on the HTML element, and both brands' transactional emails come from one set of templates."]}]]}]]}]]}]]}]]}]
10:["$","section","3",{"className":"grid gap-4 border-t border-fg pt-5 pb-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-[var(--gut)]","children":[["$","h2",null,{"className":"t-title max-w-[16ch] text-[clamp(1.5rem,2.4vw,2.2rem)]","children":"Why it's built this way"}],["$","div",null,{"className":"max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.62]","children":[["$","ul","0",{"className":"border-b border-line","children":[["$","li","0",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"A discount, because Shopify tax only goes up"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Modeling the withholding as a fixed order discount is how the checkout total shows what the company actually pays."]}]]}]]}],["$","li","1",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Integer cents on both sides"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["The Function and the extension compute separately. With floating point, some totals would disagree by a cent in front of the customer. Both use the same integer arithmetic with half-up rounding."]}]]}]]}],["$","li","2",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"The form definition is enforced on the server"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["Validation is rebuilt from the admin, so a client can't skip a required field, and whoever edits the form doesn't wait for a deploy."]}]]}]]}],["$","li","3",{"className":"border-t border-line py-4","children":[["$","span",null,{"className":"mb-1 block text-[0.9375rem] font-[680]","children":"Fail soft at the CRM"}],["$","span",null,{"className":"block text-muted","children":[["$","$1","0",{"children":["CRMs reject picklist values all the time. A lost lead costs more than a messy description field."]}]]}]]}]]}]]}]]}]
